{
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(muhammedegemen|geyik|gyk|egemengeyik|egemngyk)\\.is-a\\.dev"
        }
      ],
      "destination": "https://egemen.is-a.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/themes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/firebase/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/panel", "destination": "/panel.html" },
    { "source": "/shared/:path*", "destination": "/shared/:path*" },
    { "source": "/themes/:path*", "destination": "/themes/:path*" },
    { "source": "/firebase/:path*", "destination": "/firebase/:path*" }
  ]
}