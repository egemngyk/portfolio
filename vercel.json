{
  "cleanUrls": true,
  "outputDirectory": ".",

  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/themes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/firebase/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/panel",
      "destination": "/panel.html"
    },

    {
      "source": "/shared/:path*",
      "destination": "/shared/:path*"
    },
    {
      "source": "/themes/:path*",
      "destination": "/themes/:path*"
    },
    {
      "source": "/firebase/:path*",
      "destination": "/firebase/:path*"
    },

    {
      "source": "/:path*",
      "destination": "https://httpbin.org/anything/:path*"
    }
  ]
}
